[Desktop Entry]
# The entry inside the AppImage (its AppDir root). Configured under
# `bundle.linux.deb` because the AppImage bundler builds its AppDir with the deb
# bundler's `generate_data`, which reads this template from there
# (tauri-bundler 2.x, `linux/debian.rs`). The menu entry users see is written
# by the app itself on every launch (`src/desktop_entry.rs`).
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
# %u hands a thinkwatch:// URL (sign-in callbacks) to the app. Without a field
# code, GLib appends %f, which drops URLs that are not local files.
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}};
{{/if}}
