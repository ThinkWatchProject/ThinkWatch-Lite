{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的能力。Tauri v2 的 capability 漏配是静默失败（DESIGN.md §9.7）—— 加一个新命令就要回来确认这里有它。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:app:allow-app-hide",
    "core:event:default",
    "core:tray:default"
  ]
}
