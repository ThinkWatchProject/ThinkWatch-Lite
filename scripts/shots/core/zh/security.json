  "inspect_tools": {
    "mode": "enforce",
    "rules": [
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "curl-pipe-sh",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(curl|wget)[^\\n|]*\\|\\s*(sudo\\s+)?(ba|z|d)?sh"
        },
        "name": "Download and run",
        "on_by_default": true,
        "why": "Downloads and runs it straight away; what runs is decided remotely and cannot be read first"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "base64-decode-exec",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)base64\\s+(-d|--decode)[^\\n|]*\\|\\s*(ba)?sh"
        },
        "name": "Decode and run",
        "on_by_default": true,
        "why": "Hides what will run inside base64"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-env",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(env|printenv|cat\\s+[^\\n]{0,60}\\.env)[^\\n]{0,200}(curl|wget|nc\\s)"
        },
        "name": "Send out environment variables",
        "on_by_default": true,
        "why": "Sends the environment, which usually holds keys, somewhere else"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-credentials",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(\\.ssh/id_|\\.aws/credentials|\\.netrc|/\\.env)[^\\n]{0,30}(发|传|上报|打印|输出|贴出|读出|(?i:send|upload|post|print|paste|exfil))"
        },
        "name": "Send out a credential file",
        "on_by_default": true,
        "why": "Asks the model to send the contents of a credential file somewhere"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-credentials-reversed",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(发送|上传|贴出|打印|输出|读取|(?i:send|upload|post|print|read))[^\\n]{0,30}(\\.ssh/id_|\\.aws/credentials|\\.netrc|/\\.env)"
        },
        "name": "Send out a credential file (verb first)",
        "on_by_default": true,
        "why": "Asks the model to send the contents of a credential file somewhere"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "ssh-key-read",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(cat|cp|scp|curl)[^\\n]{0,200}(\\.ssh/id_|\\.aws/credentials|\\.netrc)"
        },
        "name": "Read a private key or cloud credential",
        "on_by_default": true,
        "why": "Reads a private key or a cloud credential"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "secret-to-unknown-host",
        "kind": "command",
        "matcher": {
          "check": "credential-to-network",
          "kind": "builtin"
        },
        "name": "Send a credential to an unknown host",
        "on_by_default": true,
        "why": "Sends a credential to a host that is neither local nor the credential's own provider"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "thinkwatch-data",
        "kind": "command",
        "matcher": {
          "check": "thinkwatch-data",
          "kind": "builtin"
        },
        "name": "Read or change ThinkWatch's own data",
        "on_by_default": true,
        "why": "Reads or changes ThinkWatch's data directory, which holds every upstream key in plain text and the settings of these protections"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "write-startup-item",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(>>?|tee|cp|mv|ln\\s+-s)[^\\n]{0,200}(\\.zshrc|\\.bashrc|\\.bash_profile|\\.profile|\\.zprofile|LaunchAgents|LaunchDaemons|\\.git/hooks|crontab)"
        },
        "name": "Write a startup item",
        "on_by_default": true,
        "why": "Writes somewhere that runs at login or whenever a terminal opens"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "crontab-install",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "crontab\\s+(-r\\b|-\\s*($|[\"';&|)])|[^\\s-][^\\n]{0,40})"
        },
        "name": "Install a scheduled job",
        "on_by_default": true,
        "why": "Installs a scheduled job, or deletes every existing one"
      },
      {
        "action": "record",
        "custom": false,
        "default_action": "record",
        "enabled": true,
        "id": "rm-rf-root",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "rm\\s+(-[a-zA-Z]*\\s+)*-[a-zA-Z]*[rf][a-zA-Z]*\\s+(/|~|\\$HOME)(\\s|$|[\"';&|)])"
        },
        "name": "Delete home or root",
        "on_by_default": true,
        "why": "Deletes the whole home directory or the root"
      },
      {
        "action": "record",
        "custom": false,
        "default_action": "record",
        "enabled": true,
        "id": "chmod-777",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "chmod\\s+(-R\\s+)?777"
        },
        "name": "World-writable permissions",
        "on_by_default": true,
        "why": "Makes a file writable by everyone"
      },
      {
        "action": "record",
        "custom": false,
        "default_action": "record",
        "enabled": true,
        "id": "upload-file-to-host",
        "kind": "command",
        "matcher": {
          "check": "file-to-network",
          "kind": "builtin"
        },
        "name": "Upload a local file to an external host",
        "on_by_default": true,
        "why": "Uploads the contents of a local file to an external host"
      }
    ]
  },
