  "hidden_text": {
    "mode": "observe",
    "rules": [
      {
        "custom": false,
        "enabled": true,
        "id": "tag",
        "kind": "invisible",
        "matcher": {
          "kind": "codepoints",
          "ranges": [
            "U+E0000–U+E007F"
          ]
        },
        "name": "tag",
        "on_by_default": true,
        "why": "Unicode tag characters: entirely invisible in an editor, carried into the model's context as they are, and able to hide a whole instruction."
      },
      {
        "custom": false,
        "enabled": true,
        "id": "bidi",
        "kind": "invisible",
        "matcher": {
          "kind": "codepoints",
          "ranges": [
            "U+202A–U+202E",
            "U+2066–U+2069"
          ]
        },
        "name": "bidi",
        "on_by_default": true,
        "why": "Bidirectional controls: they make what is on screen read in a different order than the characters actually are."
      }
    ]
  },
  "inspect_tools": {
    "mode": "enforce",
    "rules": [
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "curl-pipe-sh",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(curl|wget)[^\\n|]*\\|\\s*(sudo\\s+)?(ba|z|d)?sh"
        },
        "name": "Download and run",
        "on_by_default": true,
        "why": "Downloads and runs it straight away; what runs is decided remotely and cannot be read first"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "base64-decode-exec",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)base64\\s+(-d|--decode)[^\\n|]*\\|\\s*(ba)?sh"
        },
        "name": "Decode and run",
        "on_by_default": true,
        "why": "Hides what will run inside base64"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-env",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(env|printenv|cat\\s+[^\\n]{0,60}\\.env)[^\\n]{0,200}(curl|wget|nc\\s)"
        },
        "name": "Send out environment variables",
        "on_by_default": true,
        "why": "Sends the environment, which usually holds keys, somewhere else"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-credentials",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(\\.ssh/id_|\\.aws/credentials|\\.netrc|/\\.env)[^\\n]{0,30}(发|传|上报|打印|输出|贴出|读出|(?i:send|upload|post|print|paste|exfil))"
        },
        "name": "Send out a credential file",
        "on_by_default": true,
        "why": "Asks the model to send the contents of a credential file somewhere"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "exfil-credentials-reversed",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(发送|上传|贴出|打印|输出|读取|(?i:send|upload|post|print|read))[^\\n]{0,30}(\\.ssh/id_|\\.aws/credentials|\\.netrc|/\\.env)"
        },
        "name": "Send out a credential file (verb first)",
        "on_by_default": true,
        "why": "Asks the model to send the contents of a credential file somewhere"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "ssh-key-read",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(?i)(cat|cp|scp|curl)[^\\n]{0,200}(\\.ssh/id_|\\.aws/credentials|\\.netrc)"
        },
        "name": "Read a private key or cloud credential",
        "on_by_default": true,
        "why": "Reads a private key or a cloud credential"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "write-startup-item",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "(>>?|tee|cp|mv|ln\\s+-s)[^\\n]{0,200}(\\.zshrc|\\.bashrc|\\.bash_profile|\\.profile|\\.zprofile|LaunchAgents|LaunchDaemons|\\.git/hooks|crontab)"
        },
        "name": "Write a startup item",
        "on_by_default": true,
        "why": "Writes somewhere that runs at login or whenever a terminal opens"
      },
      {
        "action": "cut",
        "custom": false,
        "default_action": "cut",
        "enabled": true,
        "id": "crontab-install",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "crontab\\s+(-r\\b|-\\s*($|[\"';&|)])|[^\\s-][^\\n]{0,40})"
        },
        "name": "Install a scheduled job",
        "on_by_default": true,
        "why": "Installs a scheduled job, or deletes every existing one"
      },
      {
        "action": "record",
        "custom": false,
        "default_action": "record",
        "enabled": true,
        "id": "rm-rf-root",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "rm\\s+(-[a-zA-Z]*\\s+)*-[a-zA-Z]*[rf][a-zA-Z]*\\s+(/|~|\\$HOME)(\\s|$|[\"';&|)])"
        },
        "name": "Delete home or root",
        "on_by_default": true,
        "why": "Deletes the whole home directory or the root"
      },
      {
        "action": "record",
        "custom": false,
        "default_action": "record",
        "enabled": true,
        "id": "chmod-777",
        "kind": "command",
        "matcher": {
          "kind": "regex",
          "pattern": "chmod\\s+(-R\\s+)?777"
        },
        "name": "World-writable permissions",
        "on_by_default": true,
        "why": "Makes a file writable by everyone"
      }
    ]
  },
  "output_limit": {
    "ceiling": 1000000,
    "default_max_chars": 100000,
    "max_chars": 100000,
    "mode": "off"
