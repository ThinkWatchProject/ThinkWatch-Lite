    },
    {
      "host": "generativelanguage.googleapis.com",
      "service": "gemini"
    },
    {
      "host": "api.deepseek.com",
      "service": "deepseek"
    },
    {
      "host": "openrouter.ai",
      "service": "openrouter"
    },
    {
      "host": "api.z.ai",
      "service": "zai"
    },
    {
      "host": "open.bigmodel.cn",
      "service": "zai"
    }
  ],
  "zai": {
    "zai": "https://api.z.ai/api/anthropic",
    "bigmodel": "https://open.bigmodel.cn/api/anthropic"
  },
  "protocols": [
    "anthropic",
    "openai-chat",
    "openai-responses",
    "gemini"
  ],
  "bedrock_default_region": "us-east-1"
