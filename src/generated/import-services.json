{
  "services": [
    {
      "id": "anthropic",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "own",
        "address": "https://api.anthropic.com"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": "anthropic"
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "openai",
      "auth": [
        "key",
        "account"
      ],
      "address": {
        "kind": "own",
        "address": "https://api.openai.com"
      },
      "protocols": {
        "kind": "choice",
        "protocols": [
          "openai-chat",
          "openai-responses"
        ]
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "gemini",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "own",
        "address": "https://generativelanguage.googleapis.com"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": "gemini"
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "deepseek",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "own",
        "address": "https://api.deepseek.com/anthropic"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": "anthropic"
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
