      "protocols": {
        "kind": "fixed",
        "protocol": "openai-chat"
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "thinkwatch",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "required"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": null
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "sub2api",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "required"
      },
      "protocols": {
        "kind": "choice",
        "protocols": [
          "anthropic",
          "openai-chat",
          "openai-responses",
          "gemini"
        ]
      },
      "key": "required",
      "client_identity": true,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "newapi",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "required"
      },
      "protocols": {
        "kind": "choice",
        "protocols": [
          "anthropic",
          "openai-chat",
          "openai-responses",
          "gemini"
        ]
      },
      "key": "required",
      "client_identity": true,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "ollama",
      "auth": [
        "key"
      ],
      "address": {
        "kind": "local",
        "default": "http://127.0.0.1:11434"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": "openai-chat"
      },
      "key": "none",
      "client_identity": false,
      "balance": false,
      "billing": "free"
    },
    {
      "id": "custom",
      "auth": [
        "key",
        "oauth"
      ],
      "address": {
        "kind": "required"
      },
      "protocols": {
        "kind": "choice",
        "protocols": [
          "anthropic",
          "openai-chat",
          "openai-responses",
          "gemini"
        ]
      },
      "key": "optional",
      "client_identity": true,
      "balance": true,
      "billing": "per-token"
    }
