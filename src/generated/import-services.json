      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "bedrock",
      "auth": [
        "key",
        "aws-keys"
      ],
      "address": {
        "kind": "endpoint",
        "default": "https://bedrock-runtime.us-east-1.amazonaws.com"
      },
      "protocols": {
        "kind": "fixed",
        "protocol": "bedrock"
      },
      "key": "required",
      "client_identity": false,
      "balance": false,
      "billing": "per-token"
    },
    {
      "id": "openrouter",
      "auth": [
        "key"
      ],
